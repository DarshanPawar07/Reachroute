PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/bulk_messenger
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGIN=http://localhost:5173

# Secrets: use long random strings (e.g. `openssl rand -hex 32`) and never commit them.
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts users' saved SMTP passwords. If you change it, saved SMTP passwords stop working.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# The address recipients' browsers use to reach this API. Every email's unsubscribe link points here,
# so in production it must be a public https URL.
PUBLIC_URL=http://localhost:4000

# ---------------- WhatsApp ----------------
# Where Baileys stores each user's WhatsApp session. Keep this off git and restrict access:
# anyone with these files can act as the linked account.
AUTH_DIR=./.wa-sessions
MAX_CONTACTS_PER_UPLOAD=100
DAILY_CAP_PER_ACCOUNT=100
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90
DEFAULT_COUNTRY=IN

# ---------------- Email ----------------
EMAIL_MAX_CONTACTS_PER_UPLOAD=500
EMAIL_DAILY_CAP_PER_ACCOUNT=500
EMAIL_MIN_DELAY_SECONDS=2
EMAIL_MAX_DELAY_SECONDS=6

# Local testing only: allow SMTP servers on localhost (e.g. Mailpit on port 1025).
# ALLOW_PRIVATE_SMTP=true

# Optional: a platform-wide SMTP (e.g. Amazon SES) used when a user hasn't saved their own settings.
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# ---- scheduled campaigns ----
# How many days ahead a campaign may be scheduled to start.
MAX_SCHEDULE_DAYS=30